// =============================================================================
// TalentFlow — Prisma schema
//
// Conventions applied to every tenant-owned table:
//   id            String   @id @default(cuid())
//   tenantId      String   (indexed; every uniqueness constraint compounds on it)
//   createdAt / updatedAt / deletedAt            (soft delete)
//   createdById / updatedById  String?           (actor stamps)
//
// Actor stamps are plain columns rather than foreign keys on purpose: they must
// survive user deletion and be writable by background jobs that have no User
// row. The authoritative, queryable actor relationship lives in `AuditLog`.
//
// Tests in `apps/api/test/enum-parity.spec.ts` assert that these enums match
// their Zod counterparts in `packages/types`.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

