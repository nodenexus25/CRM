{
  "rootDir": "..",
  "testEnvironment": "node",
  "moduleFileExtensions": ["js", "json", "ts"],
  "testRegex": "\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "tsconfig.scripts.json", "isolatedModules": true }]
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1"
  },
  "setupFiles": ["<rootDir>/test/setup-e2e.ts"],
  "testTimeout": 60000,
  "maxWorkers": 1,
  "clearMocks": true,
  "forceExit": true
}
