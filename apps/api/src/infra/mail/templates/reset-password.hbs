<!doctype html>
<html lang="en">
  <body style="margin:0;padding:0;background:#f4f5f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 1px 3px rgba(15,23,42,0.08);">
            <tr>
              <td style="padding:28px 32px 8px;">
                <span style="font-size:16px;font-weight:700;color:#111827;">{{appName}}</span>
              </td>
            </tr>
            <tr>
              <td style="padding:8px 32px 0;">
                <h1 style="margin:0 0 12px;font-size:22px;line-height:1.3;color:#111827;">Reset your password</h1>
                <p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#4b5563;">
                  Hi {{firstName}}, we received a request to reset the password for your {{appName}} account.
                </p>
              </td>
            </tr>
            <tr>
              <td style="padding:8px 32px 8px;">
                <a href="{{resetUrl}}" style="display:inline-block;padding:12px 22px;border-radius:8px;background:#4f46e5;color:#ffffff;font-size:15px;font-weight:600;text-decoration:none;">
                  Choose a new password
                </a>
              </td>
            </tr>
            <tr>
              <td style="padding:16px 32px 4px;">
                <p style="margin:0;font-size:13px;line-height:1.6;color:#6b7280;">
                  This link expires in {{expiresInMinutes}} minutes and can only be used once. If you did not
                  request a reset, no action is needed — your password will not change.
                </p>
              </td>
            </tr>
            <tr>
              <td style="padding:20px 32px 28px;">
                <p style="margin:0;font-size:12px;line-height:1.6;color:#9ca3af;word-break:break-all;">
                  Button not working? Paste this into your browser:<br />
                  <a href="{{resetUrl}}" style="color:#4f46e5;">{{resetUrl}}</a>
                </p>
              </td>
            </tr>
            <tr>
              <td style="padding:16px 32px;background:#f9fafb;border-top:1px solid #eef0f3;">
                <p style="margin:0;font-size:12px;color:#9ca3af;">© {{year}} {{appName}}. All rights reserved.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
