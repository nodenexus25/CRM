# =============================================================================
# TalentFlow — environment template
# Copy to `.env` at the repository root:  cp .env.example .env
# Every value below is safe for local development. Replace for any deployment.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
APP_NAME=TalentFlow
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PREFIX=api/v1
WEB_ORIGIN=http://localhost:3000
# Root domain used for tenant subdomains: <slug>.talentflow.app
ROOT_DOMAIN=talentflow.app
PORT=4000

# --- Database ----------------------------------------------------------------
# Host port 5433 is used by docker-compose to avoid clashing with other stacks.
DATABASE_URL=postgresql://talentflow:talentflow@localhost:5433/talentflow?schema=public&connection_limit=10

# --- Row Level Security (layer 3) --------------------------------------------
# `pnpm db:rls` applies prisma/rls.sql: ENABLE ROW LEVEL SECURITY + a
# `tenant_isolation` policy on every tenant-owned table, plus a non-owner role
# that has DML rights but no BYPASSRLS.
RLS_APP_ROLE=talentflow_app
# `true` also FORCEs the policies on the table owner. Only enable this when the
# API connects with a role that sets `app.tenant_id` per transaction
# (see prisma/apply-rls.ts) — otherwise every query returns zero rows.
RLS_FORCE=false

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6380

# --- Object storage (S3 / MinIO) ---------------------------------------------
S3_ENDPOINT=http://localhost:9020
S3_REGION=us-east-1
S3_ACCESS_KEY=talentflow
S3_SECRET_KEY=talentflow123
S3_BUCKET=talentflow-files
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9020
# Signed URL lifetime (seconds)
S3_SIGNED_URL_TTL=900

# --- Auth --------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-000000000000000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-00000000000000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# --- Email (Mailpit locally) -------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1035
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="TalentFlow <no-reply@talentflow.local>"
MAILPIT_UI_URL=http://localhost:8035

# --- Rate limiting -----------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=120
THROTTLE_AUTH_TTL=60
THROTTLE_AUTH_LIMIT=10

# --- Billing (Phase 5) -------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- AI (Phase 2 resume parsing / Phase 6 matching) --------------------------
# `regex` (default) parses resumes deterministically with no external call;
# `openai` / `anthropic` enable the LLM parser (requires LLM_API_KEY); `none`
# disables AI features entirely.
LLM_PROVIDER=regex
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# --- Web (Next.js) -----------------------------------------------------------
# Origin of the NestJS API. The browser calls it directly with credentials, so
# this must match one of the API's WEB_ORIGIN entries.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_PREFIX=api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=TalentFlow
NEXT_PUBLIC_ROOT_DOMAIN=talentflow.app

# --- Seed --------------------------------------------------------------------
SEED_DEMO_EMAIL=admin@acme-demo.test
SEED_DEMO_PASSWORD=Passw0rd!23
# Platform operator inside the hidden `talentflow-platform` workspace.
SEED_SUPER_ADMIN_EMAIL=superadmin@talentflow.test
SEED_WORKSPACE_PASSWORD=Passw0rd!23
